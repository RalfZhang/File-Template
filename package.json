{
    "name": "filetemplate",
    "displayName": "File Template",
    "description": "An extension for creating files from templates automatically.",
    "version": "3.0.1",
    "publisher": "RalfZhang",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RalfZhang/File-Template.git"
    },
    "icon": "logo.png",
    "keywords": [
        "file",
        "template",
        "tmpl",
        "snippet"
    ],
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Snippets"
    ],
    "activationEvents": [
        "onCommand:extension.tmpl",
        "onCommand:extension.tmpljavascript",
        "onCommand:extension.tmpljavascriptreact",
        "onCommand:extension.tmpltypescript",
        "onCommand:extension.tmpltypescriptreact",
        "onCommand:extension.tmplhtml",
        "onCommand:extension.tmplcss",
        "onCommand:extension.tmplphp",
        "onCommand:extension.tmplpython",
        "onCommand:extension.tmplruby",
        "onCommand:extension.tmplxml",
        "onCommand:extension.tmplvue",
        "onCommand:extension.tmplOpenFolder"
    ],
    "main": "./out/src/extension",
    "contributes": {
        "commands": [
            {
                "command": "extension.tmpl",
                "title": "Insert Template",
                "category": "File Template"
            },
            {
                "command": "extension.tmpljavascript",
                "title": "Insert JavaScript Template",
                "category": "File Template"
            },
            {
                "command": "extension.tmpljavascriptreact",
                "title": "Insert JavaScript JSX Template",
                "category": "File Template"
            },
            {
                "command": "extension.tmpltypescript",
                "title": "Insert TypeScript Template",
                "category": "File Template"
            },
            {
                "command": "extension.tmpltypescriptreact",
                "title": "Insert TypeScript JSX Template",
                "category": "File Template"
            },
            {
                "command": "extension.tmplhtml",
                "title": "Insert HTML Template",
                "category": "File Template"
            },
            {
                "command": "extension.tmplcss",
                "title": "Insert CSS Template",
                "category": "File Template"
            },
            {
                "command": "extension.tmplphp",
                "title": "Insert PHP Template",
                "category": "File Template"
            },
            {
                "command": "extension.tmplpython",
                "title": "Insert Python Template",
                "category": "File Template"
            },
            {
                "command": "extension.tmplruby",
                "title": "Insert Ruby Template",
                "category": "File Template"
            },
            {
                "command": "extension.tmplxml",
                "title": "Insert XML Template",
                "category": "File Template"
            },
            {
                "command": "extension.tmplvue",
                "title": "Insert Vue Template",
                "category": "File Template"
            },
            {
                "command": "extension.tmplOpenFolder",
                "title": "Open Templates Folder",
                "category": "File Template"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "tsc -p ./",
        "compile": "tsc -watch -p ./",
        "pretest": "tsc -p ./",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "typescript": "^5.4.5",
        "@types/vscode": "^1.74.0",
        "@types/node": "^20.11.30",
        "@types/mocha": "^10.0.6",
        "mocha": "^10.4.0",
        "glob": "^10.3.12",
        "@vscode/test-electron": "^3.1.0"
    }
}
